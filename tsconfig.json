{
    "compilerOptions": {
        "target": "ES2022",
        "module": "CommonJS",
        "moduleResolution": "node",
        "ignoreDeprecations": "6.0",
        "outDir": "./dist",
        "rootDir": "./",
        "strict": true,
        "types": ["node"],
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true
    },
    "include": [
        "index.ts",
        "config/**/*",
        "models/**/*",
        "routes/**/*",
        "services/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}